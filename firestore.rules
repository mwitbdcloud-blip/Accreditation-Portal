rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function isStaffOrAdmin() {
      return isAuthenticated() && (
        getUserData().get('role', '') == 'staff' || 
        getUserData().get('role', '') == 'admin' ||
        request.auth.token.get('email', '') == 'mwi.tbdcloud@gmail.com'
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().get('role', '') == 'admin' ||
        request.auth.token.get('email', '') == 'mwi.tbdcloud@gmail.com'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAgentOwner(affiliateCode) {
      return (isAuthenticated() && (
        getUserData().get('affiliateCode', '') == affiliateCode || 
        isStaffOrAdmin()
      )) || !isAuthenticated();
    }

    // Connection test probe
    match /test/{docId} {
      allow read, write: if true;
    }

    // User accounts
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaffOrAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // Agents permanent profiles
    match /agents/{affiliateCode} {
      allow read: if true;
      allow create: if true;
      allow update: if isAgentOwner(affiliateCode) || isStaffOrAdmin();
      allow delete: if isAdmin();
    }

    // Accreditation applications (Permits applicant onboarding, sync, and review)
    match /applications/{applicationId} {
      allow read: if isStaffOrAdmin() || 
        (isAuthenticated() && resource.data.get('affiliateCode', '') == getUserData().get('affiliateCode', '')) ||
        !isAuthenticated();
      allow create: if true;
      allow update: if isStaffOrAdmin() ||
        (isAuthenticated() && resource.data.get('affiliateCode', '') == getUserData().get('affiliateCode', '') && resource.data.get('status', '') in ['Draft', 'Revision Required']) ||
        !isAuthenticated();
      allow delete: if isAdmin();
    }

    // Accreditations history
    match /accreditations/{accreditationId} {
      allow read: if isStaffOrAdmin() || (isAuthenticated() && resource.data.get('affiliateCode', '') == getUserData().get('affiliateCode', ''));
      allow create, update: if isStaffOrAdmin();
      allow delete: if isAdmin();
    }

    // Position access requests
    match /positionRequests/{requestId} {
      allow read: if isStaffOrAdmin() || 
        (isAuthenticated() && resource.data.get('affiliateCode', '') == getUserData().get('affiliateCode', '')) ||
        !isAuthenticated();
      allow create: if true;
      allow update, delete: if isStaffOrAdmin();
    }

    // Documents metadata
    match /documents/{documentId} {
      allow read: if isStaffOrAdmin() ||
        (isAuthenticated() && resource.data.get('affiliateCode', '') == getUserData().get('affiliateCode', '')) ||
        !isAuthenticated();
      allow create: if true;
      allow update, delete: if isStaffOrAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isStaffOrAdmin() ||
        (isAuthenticated() && (
          resource.data.get('recipientId', '') == request.auth.uid || 
          resource.data.get('affiliateCode', '') == getUserData().get('affiliateCode', '')
        )) ||
        !isAuthenticated();
      allow create: if true;
      allow update: if isStaffOrAdmin() ||
        (isAuthenticated() && resource.data.get('recipientId', '') == request.auth.uid) ||
        !isAuthenticated();
      allow delete: if isAdmin();
    }

    // Audit logs (Read only by Staff & Admin, append allowed)
    match /auditLogs/{logId} {
      allow read: if isStaffOrAdmin();
      allow create: if true;
      allow update, delete: if false; // Immutable audit log
    }

    // System Settings (Admin only write, public read)
    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
