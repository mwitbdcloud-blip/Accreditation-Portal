# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE SHEETS AGENTS DATABASE
GOOGLE_SHEETS_SPREADSHEET_ID="1eR7gskoH17WcawaC31Xk6zrnBgS6dsnF_SAMPLE_SHEET_ID"
GOOGLE_APPS_SCRIPT_WEBAPP_URL=""

# GOOGLE DRIVE & DOCS CONTRACT GENERATION
GOOGLE_DRIVE_ROOT_FOLDER_ID="1eR7gskoH17WcawaC31Xk6zrnBgS6dsnF"
GOOGLE_DOCS_CONTRACT_TEMPLATE_ID=""

# EMAIL NOTIFICATION SERVICE (SMTP / SENDGRID / RESEND)
NOTIFICATION_EMAIL_SENDER="no-reply@megaworldinternational.com"
EMAIL_SERVICE_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
